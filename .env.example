# Production domain, used for canonical URLs, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Content dashboard (/admin). Both values are public by design: the publishable
# key only allows what the database's Row Level Security permits visitors to do,
# which is reading published content. Leave both empty to run the site on its
# built-in content without the dashboard.
#
# Never add a Supabase secret or service_role key here. The site does not need one.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
